	measure 'Worst Shipping Mode Name' = ```
			
			VAR ModeGap = 
			    ADDCOLUMNS(
			        VALUES(Dim_Shipping[Shipping Mode]),
			        "DayGap", [Avg Real Shipping Days] - [Avg Scheduled Shipping Days]
			    )
			RETURN
			    MAXX(
			        TOPN(1, ModeGap, [DayGap], DESC),
			        Dim_Shipping[Shipping Mode]
			    )
			```
		displayFolder: 05 Top N & Ranking
		lineageTag: 2d3188ef-8114-4ba2-ae61-76b5bbde493a

	measure 'Fraud Sales Text' = FORMAT([Fraud Sales] / 1000, "$#,##0.0K", "en-US")
