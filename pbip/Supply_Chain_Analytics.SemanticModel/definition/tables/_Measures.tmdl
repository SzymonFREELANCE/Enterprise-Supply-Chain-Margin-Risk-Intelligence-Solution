	measure 'Top Fraud Region 1' = TOPN(1, VALUES(Dim_Geography[Order Region]), [Fraud Orders Count], DESC)
		displayFolder: 05 Top N & Ranking
		lineageTag: ae5a655d-3f68-475d-8914-1cc0500850e5

	measure 'Top Fraud Region 1 Count' =
			
			VAR TopR = [Top Fraud Region 1]
			RETURN FORMAT(CALCULATE([Fraud Orders Count], Dim_Geography[Order Region] = TopR), "#,##0")
		displayFolder: 05 Top N & Ranking
		lineageTag: 64fd0312-930f-4ef1-8a99-2cf8273f73af

	measure 'Top Fraud Region 2' = ```
			
			VAR Top2Table = 
			    TOPN(2, VALUES(Dim_Geography[Order Region]), [Fraud Orders Count], DESC)
			VAR Top1Table = 
			    TOPN(1, VALUES(Dim_Geography[Order Region]), [Fraud Orders Count], DESC)
			RETURN
			    MAXX(
			        EXCEPT(Top2Table, Top1Table),
			        Dim_Geography[Order Region]
			    )
			```
		displayFolder: 05 Top N & Ranking
		lineageTag: 8066cf7e-928f-4ed6-8021-ff86988c64a5

	measure 'Worst Mode Details Text' = ```
			
			VAR WorstMode = [Worst Shipping Mode Name]
			VAR RealDays = 
			    CALCULATE(
			        [Avg Real Shipping Days], 
			        Dim_Shipping[Shipping Mode] = WorstMode
			    )
			VAR SchedDays = 
			    CALCULATE(
			        [Avg Scheduled Shipping Days], 
			        Dim_Shipping[Shipping Mode] = WorstMode
			    )
			RETURN
			    WorstMode & " (actual ~" & FORMAT(RealDays, "0.0") & " days vs. " & FORMAT(SchedDays, "0.0") & "-day SLA)"
			```
		displayFolder: 03 Dynamic Text & KPI Labels
		lineageTag: 64951a8e-7f28-45c8-8524-dda48af04dd5

	measure 'Top Fraud Region 2 Count' = ```
			
			VAR Region2 = [Top Fraud Region 2]
			RETURN
			    FORMAT(
			        CALCULATE([Fraud Orders Count], Dim_Geography[Order Region] = Region2), 
			        "#,##0"
			    )
			```
		displayFolder: 05 Top N & Ranking
		lineageTag: ca7b4749-a716-4a31-9fd3-8f90e2f6e796

	measure 'Top2 Fraud Share Pct Text' = ```
			
			VAR Top2Table = 
			    TOPN(2, VALUES(Dim_Geography[Order Region]), [Fraud Orders Count], DESC)
			VAR Top2Count = 
			    CALCULATE(
			        [Fraud Orders Count], 
			        KEEPFILTERS(Top2Table)
			    )
			VAR TotalFraudOrders = 
			    CALCULATE(
			        [Fraud Orders Count], 
			        ALLSELECTED(Dim_Geography[Order Region])
			    )
			RETURN
			    FORMAT(DIVIDE(Top2Count, TotalFraudOrders), "0.0%", "en-US")
			```
		displayFolder: 03 Dynamic Text & KPI Labels
		lineageTag: 4e88103d-679d-4615-be2a-f16a30a8eb00

	measure 'Top1 Fraud Share Pct Text' = ```
			
			VAR TopReg = [Top Fraud Region 1]
			VAR Top1Count = 
			    CALCULATE(
			        [Fraud Orders Count], 
			        'Dim_Geography'[Order Region] = TopReg
			    )
			VAR TotalFilteredCount = 
			    CALCULATE(
			        [Fraud Orders Count], 
			        ALLSELECTED('Dim_Geography'[Order Region])
			    )
			RETURN
			    FORMAT(
			        DIVIDE(Top1Count, TotalFilteredCount), 
			        "0.0%", 
			        "en-US"
			    )
			```
		displayFolder: 03 Dynamic Text & KPI Labels
		lineageTag: e7acbfff-d9f0-4a92-8320-8e099ae89013

