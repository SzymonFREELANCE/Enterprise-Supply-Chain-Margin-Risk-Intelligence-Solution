	measure 'Sales Dynamic Text' =
			
			VAR Val = [Total Sales]
			RETURN
			SWITCH(
			    TRUE(),
			    Val >= 1000000, FORMAT(Val / 1000000, "$#,##0.0M", "en-US"),
			    Val >= 1000, FORMAT(Val / 1000, "$#,##0.0K", "en-US"),
			    FORMAT(Val, "$#,##0", "en-US")
			)
		displayFolder: 03 Dynamic Text & KPI Labels
		lineageTag: 07b019f0-b5b6-405c-9af9-95a62653ade0

