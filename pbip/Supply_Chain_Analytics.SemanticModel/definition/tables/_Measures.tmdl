table _Measures
	lineageTag: 7c0cb5a3-6755-4043-b5d9-c6bbf6696ada

	measure 'Total Sales' = SUM('Fact_Order_Items'[sales_gross])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Measures
		lineageTag: 00dee682-3a53-4577-bff6-369988ecedf7

	measure 'Total Profit' = SUM('Fact_Order_Items'[profit_margin])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Measures
		lineageTag: 0bbe61e9-119a-41dc-8d5a-44d35487fd4d

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base Measures
		lineageTag: ab38055c-8a5e-48fe-8567-551096606de4

	measure 'Unprofitable Orders Count' =
			
			CALCULATE(
			    DISTINCTCOUNT('Fact_Order_Items'[order_id]),
			    'Fact_Order_Items'[is_unprofitable] = TRUE()
			)
		formatString: #,0
		displayFolder: 01 Base Measures
		lineageTag: aef12ea9-e657-4617-a7fd-94bef21d21b4

	measure 'Late Delivery Rate %' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT('Fact_Order_Items'[order_id]), 'Dim_Shipping'[Delivery Status] = "Late delivery"),
			    DISTINCTCOUNT('Fact_Order_Items'[order_id]),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base Measures
		lineageTag: e586c8c5-d09a-45be-b818-f2a3abce7b6e

	measure 'Avg Real Shipping Days' = AVERAGE('Fact_Order_Items'[days_for_shipping_real])
		formatString: 0.0
		displayFolder: 01 Base Measures
		lineageTag: 0895c4d6-308d-49e0-8335-e9172c28744a

	measure 'Avg Scheduled Shipping Days' = AVERAGE('Fact_Order_Items'[days_for_shipment_scheduled])
		formatString: 0.0
		displayFolder: 01 Base Measures
		lineageTag: 1ef15eaa-9797-4a7d-9e8a-1c9451b508cc

	measure 'Fraud Orders Count' =
			
			CALCULATE(
			    COUNTROWS('Fact_Order_Items'),
			    'Fact_Order_Items'[is_fraud] = TRUE()
			)
		formatString: #,0
		displayFolder: 01 Base Measures
		lineageTag: e139ab00-feb8-41a7-9ca5-c817b05329bd

	measure 'Fraud Sales' =
			
			CALCULATE(
			    SUM('Fact_Order_Items'[sales_gross]),
			    'Fact_Order_Items'[is_fraud] = TRUE()
			)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Measures
		lineageTag: eb65634a-225c-4ae5-bee8-12d51f62e417

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Fraud Order Value' =
			
			DIVIDE([Fraud Sales], [Fraud Orders Count], 0)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 01 Base Measures
		lineageTag: 2cebf8cd-d708-4e6e-ad6f-1a22d891cd26

	measure 'Avg Discount %' = AVERAGE('Fact_Order_Items'[discount_rate])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base Measures
		lineageTag: 593c324d-0b35-40e0-be08-c249b9a2e3c1

	measure 'Top Fraud Channel' =
			
			CALCULATE(
			    SELECTEDVALUE('Fact_Order_Items'[payment_type], "TRANSFER"),
			    'Fact_Order_Items'[is_fraud] = TRUE()
			)
		displayFolder: 05 Top N & Ranking
		lineageTag: b15d238a-f136-40cb-bd35-ea257a71108a

	measure 'Data Period Label' = ```
			
			"Data Period: " & 
			FORMAT(MIN('Fact_Order_Items'[order_date]), "mmm yyyy", "en-US") & 
			" - " & 
			FORMAT(MAX('Fact_Order_Items'[order_date]), "mmm yyyy", "en-US")
			```
		displayFolder: 03 Dynamic Text & KPI Labels
		lineageTag: e1d2706a-4f77-4d72-9ae1-aa9b200d6857

	measure 'Total Sales YoY Formatted' = ```
			
			VAR IsYearFiltered = HASONEVALUE('Dim_Calendar'[Year])
			VAR MaxSalesDate = MAX('Fact_Order_Items'[order_date])
			VAR CurrentYear = YEAR(MaxSalesDate)
			
			VAR CurrentVal = 
			    IF(
			        IsYearFiltered,
			        [Total Sales],
			        CALCULATE([Total Sales], 'Dim_Calendar'[Year] = CurrentYear)
			    )
			
			VAR PreviousVal = 
			    IF(
			        IsYearFiltered,
			        CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Dim_Calendar'[Date])),
			        CALCULATE([Total Sales], 'Dim_Calendar'[Year] = CurrentYear - 1)
			    )
			
			VAR YoY = DIVIDE(CurrentVal - PreviousVal, PreviousVal, BLANK())
			VAR YearLabel = IF(NOT IsYearFiltered, " (" & CurrentYear & " vs " & (CurrentYear - 1) & ")", " YoY")
			
			RETURN
			IF(
			    ISBLANK(YoY),
			    "",
			    SWITCH(
			        TRUE(),
			        ABS(YoY) < 0.0005, "► 0.0%" & YearLabel,
			        YoY > 0, "▲ " & FORMAT(YoY, "0.0%", "en-US") & YearLabel,
			        "▼ " & FORMAT(ABS(YoY), "0.0%", "en-US") & YearLabel
			    )
			)
			```
		displayFolder: 02 Time Intelligence (YoY)
		lineageTag: 4223f720-968d-4e5a-99fe-782a032b7d63

	measure 'Total Sales Color' =
			
			VAR YoYText = [Total Sales YoY Formatted]
			RETURN
			    SWITCH(
			        TRUE(),
			        CONTAINSSTRING(YoYText, "►"), "#6B7280",
			        CONTAINSSTRING(YoYText, "▲"), "#2CCE2C",
			        CONTAINSSTRING(YoYText, "▼"), "#E63946",
			        "#6B7280"
			    )
		displayFolder: 04 Formatting & Colors
		lineageTag: 02525737-5624-4ecf-995c-b2c0486e44ec

