		lineageTag: 3de7f7b3-e91f-4ff6-bab2-1c8631b24f4c

	measure 'Top Loss Category Name' =
			
			IF(
			    ISFILTERED(Dim_Products[Category Name]),
			    SELECTEDVALUE(Dim_Products[Category Name]),
			    TOPN(1, VALUES(Dim_Products[Category Name]), [Unprofitable Orders Count], DESC)
			)
		displayFolder: 05 Top N & Ranking
		lineageTag: eb3a2166-cd63-40d8-871a-6c5aedee8010

	measure 'Top Loss Category Orders K Text' = ```
			
			VAR TopCat = [Top Loss Category Name]
			VAR OrdersCount = 
			    CALCULATE(
			        [Unprofitable Orders Count],
			        Dim_Products[Category Name] = TopCat
			    )
			RETURN
			    FORMAT(OrdersCount / 1000, "#,##0.0K", "en-US")
			```
		displayFolder: 03 Dynamic Text & KPI Labels
