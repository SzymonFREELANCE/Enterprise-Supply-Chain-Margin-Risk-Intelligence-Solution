		lineageTag: 01c59944-c4a6-4bb6-856d-fd4b7e17f977

	measure 'Unprofitable Orders Count by Category Name Accent' = ```
			
			VAR MaxRevenueInContext = 
			    CALCULATE(
			        MAXX(
			            VALUES('Dim_Products'[Category Name]), 
			            [Unprofitable Orders Count]
			        ), 
			        ALLSELECTED('Dim_Products')
			    )
			VAR CurrentCategoryRevenue = [Unprofitable Orders Count]
			RETURN 
			    IF(
			        CurrentCategoryRevenue = MaxRevenueInContext, 
			        "#009999",
			        "#314F62"
			    )
			```
		displayFolder: 04 Formatting & Colors
		lineageTag: 8ac7d35b-fb1b-4162-8fd2-f6e072d987c4

	measure 'Margin Pct Text' =
			
			FORMAT([Profit Margin %], "0.0%", "en-US")
		displayFolder: 03 Dynamic Text & KPI Labels
		lineageTag: a0e2e030-0a28-47ae-a382-2c49ee3925ed

	measure 'Unprofitable Orders K Text' =
			
			FORMAT([Unprofitable Orders Count] / 1000, "#,##0.0K", "en-US")
