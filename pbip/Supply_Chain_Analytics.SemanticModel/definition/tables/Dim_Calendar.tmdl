	partition Dim_Calendar = calculated
		mode: import
		source =
				
				VAR MinYear = YEAR(MIN('Fact_Order_Items'[order_date]))
				VAR MaxYear = YEAR(MAX('Fact_Order_Items'[order_date]))
				RETURN
				ADDCOLUMNS (
				    CALENDAR(DATE(MinYear, 1, 1), DATE(MaxYear, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "mmm"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "YearMonthKey", YEAR([Date]) * 100 + MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q")
				)

	annotation PBI_Id = 58e05573847440279a67b4a95b2ef434

